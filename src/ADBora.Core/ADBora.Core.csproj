<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>AdbTool</RootNamespace>
    <AssemblyName>ADBora.Core</AssemblyName>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- All English UI texts (generated by tools/LangExtract) – used to check language files -->
    <EmbeddedResource Include="..\..\lang\template.json" LogicalName="lang.template.json" />
    <EmbeddedResource Include="Resources\ADBoraMic.apk" LogicalName="ADBoraMic.apk" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ADBora" />
  </ItemGroup>

</Project>
