<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ADBora</AssemblyName>
    <RootNamespace>AdbTool</RootNamespace>
    <ApplicationIcon>ADBora.ico</ApplicationIcon>
    <Version>2.0.2</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>ADBora</Product>
    <Authors>urscaviezel</Authors>
    <Description>ADBora – Android Device Toolbox: APK backup and install, speed test and ADB console.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ADBora.SpeedRegression" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ADBora.Core\ADBora.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="ADBora.ico" />
    <AvaloniaResource Include="..\..\Logo.png" Link="Logo.png" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildDate" Value="$([System.DateTime]::Now.ToString('yyyy-MM-dd'))" />
  </ItemGroup>

</Project>
